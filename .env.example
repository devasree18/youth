# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/youth_db?retryWrites=true&w=majority

# Security Secrets (MUST be at least 32 characters long in production)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
COOKIE_SECRET=your_super_secret_cookie_key_minimum_32_chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# External Integration Credentials (Optional - Graceful Fallbacks Implemented)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api/v1
